# Settings for compose.yaml. Copy to .env and adjust.

# Domain Traefik routes to the speed test (required).
SPEEDTEST_HOST=speedtest.example.com

# Public IP of this machine, which browsers send the monitor's UDP probe to.
# Without it browsers can't reach the probe, and after a few seconds of trying
# the monitor pings over HTTP/TCP instead.
SPEEDTEST_PUBLIC_IP=

# UDP port of the probe, published under the same number on the host.
SPEEDTEST_UDP_PORT=8080

# Branch or tag of the GitHub repository to build from.
SPEEDTEST_REF=main

# Your Traefik setup.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
